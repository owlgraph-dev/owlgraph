# Server .env for the production compose stack (docs/guides/deployment.md, "Production").
# Copy to .env on the server and fill in. Never commit the filled-in file.

# Layer docker-compose.prod.yml over the base file for every `docker compose`
# command (up, logs, exec, and the backup/restore scripts). `:` separates the
# files on Linux/macOS.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- Public origin (required) ---
# Exactly the URL visitors use: scheme + host (+ port if not 443), no path.
ORIGIN=https://kb.example.de

# --- Postgres (required) ---
# At least 16 characters, not a placeholder — `migrate` refuses otherwise.
# Stick to URL-safe characters (letters, digits, - _ .): the compose file
# embeds the passwords in postgres:// URLs, where % @ : / ? # already mean
# something ($ is compose's own interpolation).
# Pick this one before the first start: Postgres binds the superuser password
# when the volume is initialised, so changing it later needs an ALTER ROLE
# (docs/guides/deployment.md, "First run") — not just a new value here.
POSTGRES_USER=owlgraph
POSTGRES_PASSWORD=
POSTGRES_DB=owlgraph

# Least-privilege role the app and MCP server connect as (created by
# migrations/0001_baseline.sql; `migrate` sets/rotates its password from here).
APP_DB_PASSWORD=

# --- Host ports, bound to 127.0.0.1 — the reverse proxy forwards to them ---
APP_PORT=3000
MCP_PORT=3030

# --- Reverse proxy ---
# The header carrying the client address, and how many proxies append to it.
# The defaults fit one proxy on this host; raise XFF_DEPTH only if another
# proxy (e.g. a CDN) sits in front of it.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Largest request body the app accepts (documents go up to 25 MB). Keep the
# proxy's own body limit at least this large.
# BODY_SIZE_LIMIT=26M

# --- Logging (docs/architecture/logging.md) ---
# error | warn | info | debug | silent. Unset is `info`, which is the right
# resting level: every non-asset request, every audit event, every denial.
# Raise to `debug` only while diagnosing, and lower it again — `debug` is not
# covered by the catalog's guarantees. `docker compose up -d app mcp` applies
# a change; the log driver's rotation (5 x 10 MB per service) is unaffected.
# LOG_LEVEL=info

# --- Integrations (docs/architecture/plugins.md, docs/architecture/authorization.md "Secrets") ---
# The key an integration's credentials for another service are sealed with
# at rest: 32 random bytes, base64. Only needed once an integration is used;
# a value that is set has to be one — `migrate` refuses a weak key in
# production. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# It is not in any backup: keep it with the backups' other secrets, apart
# from the dumps — without it every share and every person's connection has
# to be connected again after a restore. To rotate, move the old key to
# APP_SECRET_KEY_PREVIOUS (comma-separated for several) and set a new one:
# what the old key sealed still opens (docs/architecture/authorization.md, "Secrets").
# APP_SECRET_KEY=
# APP_SECRET_KEY_PREVIOUS=

# --- Source code offer (AGPL-3.0 §13; docs/guides/deployment.md, "Source code for network users") ---
# Where the "Source code" link on every page and the MCP server's info point:
# the repository the running code comes from, and the commit it was built from.
# Running a modified owlgraph? Publish your version and point SOURCE_URL at it.
# Compose passes both to the image build; empty means the upstream repository
# and `dev`.
# SOURCE_URL=https://github.com/owlgraph-dev/owlgraph
# SOURCE_REVISION=

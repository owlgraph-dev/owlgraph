# Copy to .env and fill in. Never commit .env with real secrets.

# --- App ---
# Host-side URL for the `npm run` scripts (dev server, db:migrate, …) against a
# Postgres port-mapped to localhost. The compose services don't read it — they
# build their own URLs from the POSTGRES_* values below (docs/guides/deployment.md).
DATABASE_URL=postgres://user:password@localhost:5432/owlgraph
MCP_PORT=3030

# --- Docker Compose: database credentials (REQUIRED for `docker compose up`) ---
# Fill BOTH passwords in before starting the stack; they have no usable
# default. The image runs with NODE_ENV=production, so `migrate` refuses to
# run — and app/mcp never start — while either one is empty, still a
# placeholder ("password", "change-me", …) or shorter than 16 characters.
# This applies to a local stack exactly as it does on a server.
#
# Use letters, digits and - _ . only: compose substitutes these values into
# postgres:// URLs, where % @ : / ? # already mean something (and $ is
# compose's own interpolation). A % in a password surfaces as "URI malformed".
#
# Changing POSTGRES_PASSWORD later does NOT change the database — Postgres
# binds it when the volume is first initialised, so a later change fails
# authentication until the volume is reset (docs/guides/deployment.md, "First run").
#
# Not needed for the bare `npm run dev` workflow, which uses DATABASE_URL above.
POSTGRES_USER=user
POSTGRES_PASSWORD=
POSTGRES_DB=owlgraph

# The least-privilege role the app and mcp containers connect as (created by
# migrations/0001_baseline.sql: DML only, no CREATEDB/CREATEROLE/SUPERUSER).
# `migrate` connects as POSTGRES_USER and sets/rotates this role's password
# from the value here. Same rules as above.
APP_DB_PASSWORD=

# --- Docker Compose: app container (adapter-node) ---
APP_PORT=3000                   # host-side published port for the app
ORIGIN=http://localhost:3000    # set to the real https:// origin once TLS is in front

# Behind a reverse proxy (docker-compose.prod.yml sets these for you): the
# header carrying the client address and the number of proxy hops. The rate
# limiters key on the client address — unset behind a proxy, every visitor
# shares the proxy's address and one limit bucket.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Largest request body the app accepts (adapter-node's own default is 512K;
# documents go up to 25 MB). Compose defaults it to 26M.
# BODY_SIZE_LIMIT=26M

# Structured log verbosity: error | warn | info | debug | silent
# (docs/architecture/logging.md). Unset means debug under `npm run dev`, info in the
# production image. Applies to `npm run dev`/`npm run mcp` AND, because compose
# passes it through, to the app and mcp containers.
# LOG_LEVEL=info

# The size of each process's database pool (the app, the agents' server, a
# script); unset, 10. Compose passes it through to the app and mcp containers.
# DB_POOL_MAX=10

# Disables graphql-yoga's interactive browser IDE at /api/graphql (introspection
# queries from tooling/MCP still work either way). Off by default in prod.
ENABLE_GRAPHIQL=false

# The design-system playground at /dev/design-system (docs/architecture/design-system/overview.md,
# "Playground"): every primitive rendered in every state, for visual checks and
# the axe pass. Always on under `npm run dev`; a production build serves 404
# there unless this is set. Dev tooling, not a user surface.
ENABLE_DESIGN_PLAYGROUND=false

# --- Integrations (docs/architecture/plugins.md, docs/architecture/authorization.md "Secrets") ---
# The key an integration's credentials for another service are sealed with
# at rest: 32 random bytes, base64. Only needed once an integration is used;
# a value that is set has to be one — `migrate` refuses a weak key in
# production. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# It is not in any backup: keep it with the backups' other secrets, apart
# from the dumps — without it every share and every person's connection has
# to be connected again after a restore. To rotate, move the old key to
# APP_SECRET_KEY_PREVIOUS (comma-separated for several) and set a new one:
# what the old key sealed still opens (docs/architecture/authorization.md, "Secrets").
# APP_SECRET_KEY=
# APP_SECRET_KEY_PREVIOUS=

# --- Source code offer (AGPL-3.0 §13; docs/guides/deployment.md, "Source code for network users") ---
# Where the "Source code" link on every page and the MCP server's info point:
# the repository the running code comes from, and the commit it was built from.
# Running a modified owlgraph? Publish your version and point SOURCE_URL at it.
# Compose passes both to the image build; empty means the upstream repository
# and `dev`.
# SOURCE_URL=https://github.com/owlgraph-dev/owlgraph
# SOURCE_REVISION=

{
  "name": "owlgraph",
  "version": "0.1.0",
  "description": "A semantic knowledge graph to foster collaboration — for people and AI alike.",
  "license": "AGPL-3.0-only",
  "author": "Alexander Rensch <rensch.alexander@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/owlgraph-dev/owlgraph.git"
  },
  "private": true,
  "engines": {
    "node": ">=22.15"
  },
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync && npm run messages",
    "messages": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie baseLocale --emit-ts-declarations --silent",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && npm run messages && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && node scripts/check-boundaries.mjs && node scripts/check-ui.mjs && node scripts/check-console.mjs && node scripts/check-paths.mjs && node scripts/license-headers.mjs --check",
    "check:ui": "node scripts/check-ui.mjs",
    "license-headers": "node scripts/license-headers.mjs",
    "notices": "node scripts/notices.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "mcp": "tsx watch --tsconfig tsconfig.tsx.json --import ./scripts/lib/register-svelte.mjs src/mcp/server.ts",
    "create-admin": "tsx --tsconfig tsconfig.tsx.json scripts/create-admin.ts",
    "db:migrate": "tsx --tsconfig tsconfig.tsx.json scripts/migrate.ts",
    "db:dump-schema": "tsx --tsconfig tsconfig.tsx.json scripts/dump-schema.ts",
    "db:generate-baseline": "tsx --tsconfig tsconfig.tsx.json scripts/generate-baseline.ts",
    "db:backfill-search": "tsx --tsconfig tsconfig.tsx.json scripts/backfill-search.ts",
    "db:backup": "tsx --tsconfig tsconfig.tsx.json scripts/backup.ts",
    "db:restore": "tsx --tsconfig tsconfig.tsx.json scripts/restore.ts",
    "db:restore-test": "tsx --tsconfig tsconfig.tsx.json scripts/restore-test.ts",
    "secrets:rotate": "tsx --tsconfig tsconfig.tsx.json scripts/rotate-secrets.ts",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:component": "vitest run --project component",
    "test:watch": "vitest --project unit",
    "test:e2e": "node scripts/e2e.mjs",
    "gate": "npm run build && npm run check && npm test && npm run test:int && npm run test:component && node scripts/e2e.mjs --skip-build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.61.0",
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.13.0",
    "@vitest/browser": "^3.2.7",
    "devalue": "^5.9.4",
    "pino-pretty": "^13.1.3",
    "playwright": "1.64.1",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0",
    "vitest-browser-svelte": "^1.1.0"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.23.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@pothos/core": "^4.3.0",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-code-block-lowlight": "^2.27.3",
    "@tiptap/extension-document": "^2.27.3",
    "@tiptap/extension-heading": "^2.27.3",
    "@tiptap/extension-paragraph": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "bits-ui": "^2.18.1",
    "dompurify": "^3.4.12",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.10.0",
    "htmlparser2": "^10.1.0",
    "jsdom": "^29.1.1",
    "lowlight": "^3.1.0",
    "mermaid": "^11.0.0",
    "pdfjs-dist": "4.10.38",
    "pino": "^10.3.1",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "postgres": "^3.4.0",
    "sanitize-html": "^2.13.0",
    "sharp": "^0.35.5",
    "svelte": "^5.0.0",
    "svelte-toolbelt": "^0.10.6",
    "tsx": "^4.19.0",
    "zod": "^3.23.0"
  },
  "overrides": {
    "sanitize-html": {
      "htmlparser2": "^10.1.0"
    }
  }
}
